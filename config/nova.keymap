#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT     0
#define NUMBER      1
#define FUNCTION    2

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_qw_esc {
            bindings = <&none>;
            key-positions = <0 1>;
            slow-release;
            layers = <0 1>;
        };

        combo_op_bspc {
            bindings = <&none>;
            key-positions = <8 9>;
            slow-release;
            layers = <0 2>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  | RET |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&kp Q        &kp W  &kp E     &kp R    &kp T            &kp Y      &kp U  &kp I         &kp O    &kp P
&kp A        &kp S  &kp D     &kp F    &kp G            &kp H      &kp J  &kp K         &kp L    &kp SEMI
&mt LSHFT Z  &kp X  &kp C     &kp V    &kp B            &kp N      &kp M  &kp COMMA     &kp DOT  &mt RSHIFT FSLH
                    &kp LALT  &kp TAB  &mt LCTRL RET    &kp SPACE  &to 1  &mt LWIN RET
            >;
        };

        num_sym {
            bindings = <
&kp N1     &kp N2    &kp N3    &kp N4    &kp N5     &kp N6         &kp N7     &kp N8     &kp N9     &kp N0
&kp GRAVE  &kp LBKT  &kp LBRC  &kp LPAR  &kp DQT    &kp BACKSPACE  &kp MINUS  &kp EQUAL  &kp SEMI   &kp FSLH
&kp LSHFT  &kp RBKT  &kp RBRC  &kp RPAR  &kp SQT    &kp DEL        &kp UNDER  &kp PLUS   &kp COLON  &kp RSHFT
                     &trans    &to 0     &trans     &trans         &to 2      &trans
            >;
        };

        fun_nav {
            bindings = <
&kp F1   &kp F2    &kp F3           &kp F4      &kp F5          &kp F6   &kp F7    &kp F8     &kp F9     &kp F10
&kp F11  &kp CAPS  &kp PRINTSCREEN  &kp INSERT  &kp C_VOL_UP    &trans   &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
&kp F12  &trans    &trans           &trans      &kp C_VOL_DN    &kp DEL  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                   &to 3            &to 0       &trans          &trans   &trans    &trans
            >;
        };

        mouse_bt {
            bindings = <
&trans  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &mkp MB4      &mkp LCLK     &mkp MCLK     &mkp RCLK   &mkp MB5
&trans  &trans          &trans          &trans           &trans            &trans        &trans        &trans        &trans      &trans
                        &trans          &to 0            &trans            &trans        &trans        &trans
            >;
        };

        // &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        function {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
