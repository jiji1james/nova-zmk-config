#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT     0
#define NUMBER      1
#define FUNCTION    2

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

	td0: tap_dance_0 {
		compatible = "zmk,behavior-tap-dance";
		#binding-cells = <0>;
		tapping-term-ms = <200>;
		bindings = <&kp Q>, <&kp ESC>;
	};

    };

    keymap {
        compatible = "zmk,keymap";

        windows {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  | RET |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&td0        &kp W       &kp E           &kp R        &kp T            &kp Y      &kp U        &kp I           &kp O       &kp P
&kp A        &mt LALT S  &mt LEFT_GUI D  &mt LCTRL F  &kp G            &kp H      &mt RCTRL J  &mt LEFT_GUI K  &mt RALT L  &kp BACKSPACE
&mt LSHFT Z  &kp X       &kp C           &kp V        &kp B            &kp N      &kp M        &kp COMMA       &kp DOT     &kp RSHIFT
                         &mt LALT ESC    &lt 3 TAB    &mt LCTRL RET    &kp SPACE  &lt 2 TAB    &kp RET
            >;
        };

        mac {
            bindings = <
&kp Q  &kp W       &kp E           &kp R        &kp T           &kp Y      &kp U        &kp I           &kp O       &kp P
&kp A  &mt LALT S  &mt LEFT_GUI D  &mt LCTRL F  &kp G           &kp H      &mt RCTRL J  &mt LEFT_GUI K  &mt RALT L  &kp BACKSPACE
&kp Z  &kp X       &kp C           &kp V        &kp B           &kp N      &kp M        &kp COMMA       &kp DOT     &kp RIGHT_SHIFT
                   &kp ESC         &lt 3 LCTRL  &mt LCMD TAB    &kp SPACE  &lt 2 TAB    &kp RET
            >;
        };

        right {
            bindings = <
&kp N1   &kp N2    &kp N3           &kp N4      &kp N5          &kp N6  &kp N7    &kp N8     &kp N9     &kp N0
&kp DEL  &kp CAPS  &kp PRINTSCREEN  &kp INSERT  &kp C_VOL_UP    &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
&trans   &trans    &trans           &trans      &kp C_VOL_DN    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                   &trans           &trans      &trans          &trans  &trans    &trans
            >;
        };

        left {
            bindings = <
&kp EXCL  &kp AT    &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET   &kp AMPS   &kp ASTRK    &kp GRAVE  &kp TILDE
&kp DQT   &kp LBKT  &kp LBRC  &kp LPAR    &trans         &kp FSLH    &kp MINUS  &kp EQUAL    &kp SEMI   &kp BSLH
&kp SQT   &kp RBKT  &kp RBRC  &kp RPAR    &trans         &kp QMARK   &kp UNDER  &kp PLUS     &kp COLON  &kp PIPE
                    &trans    &trans      &trans         &kp K_COPY  &kp K_CUT  &kp K_PASTE
            >;
        };

        function {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG  &tog 1  &trans  &trans
&kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &trans        &trans  &trans  &trans
&kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &bt BT_SEL 4  &trans        &trans  &trans  &trans
                 &trans   &trans   &trans          &trans        &trans        &trans
            >;
        };

        // &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        function {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
