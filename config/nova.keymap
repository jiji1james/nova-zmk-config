#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT     0
#define NUMBER      1
#define FUNCTION    2

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo_alt_tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <10 30>;
            layers = <0>;
        };

        combo_ret {
            bindings = <&kp RET>;
            key-positions = <23 24>;
            layers = <0>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        td_colon: td_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COLON";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp SEMI>, <&kp COLON>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_qwerty {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  | RET |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&kp Q        &kp W  &kp E     &kp R     &kp T            &kp Y      &kp U  &kp I      &kp O      &kp P
&kp A        &kp S  &kp D     &kp K     &kp G            &kp H      &kp J  &kp K      &td_colon  &kp BSPC
&mt LSHFT Z  &kp X  &kp C     &kp V     &kp B            &kp N      &kp M  &kp COMMA  &kp DOT    &mt RSHFT FSLH
                    &kp LALT  &kp LWIN  &mt LCTRL TAB    &kp SPACE  &to 1  &kp RET
            >;
        };

        num_sym {
            // -----------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // |  `  |     |     |  "  |  ?  |   |  _  |  +  |  {  |  }  |  |  |
            // |  ~  |     |     |  '  |  /  |   |  -  |  =  |  [  |  ]  |  \  |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&as EXCL N1      &as AT N2  &as HASH N3  &as DLLR N4  &as PRCNT N5     &as CARET N6  &as AMPS N7  &as ASTRK N8  &as LPAR N9     &as RPAR N0
&as TILDE GRAVE  &kp LEFT   &kp UP       &kp DOWN     &kp RIGHT        &kp MINUS     &kp EQUAL    &kp LBKT      &kp RBKT        &kp BSPC
&kp LSHFT        &kp HOME   &kp PG_UP    &kp PG_DN    &kp END          &kp DEL       &none        &as DQT SQT   &as COLON SEMI  &kp BSLH
                            &kp ESC      &to 0        &mt LCTRL TAB    &kp SPACE     &to 2        &kp RET
            >;
        };

        function_layer {
            // -----------------------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
            // | F11 | F12 |     |     |     |   |     | LT  | DW  | UP  |  RT |
            // |BT CL|     | BT 0| BT 1| BT 2|   |     |HOME |PGDW |PGUP | END |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&kp F1     &kp F2   &kp F3        &kp F4        &kp F5            &kp F6     &kp F7    &kp F8     &kp F9     &kp F10
&kp F11    &kp F12  &none         &bt BT_CLR    &none             &none      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
&kp LSHFT  &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &none      &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                    &kp LALT      &to 0         &mt LCTRL BSPC    &kp SPACE  &to 0     &kp RET
            >;
        };

        // &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };
};
