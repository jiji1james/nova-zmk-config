#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define SYM     1
#define NAV     2

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
//             | ESC |  1  | SPC |   | ENT |  2  | DEL |
            bindings = <
&kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P
&mt LGUI A      &mt LALT S      &mt LSHIFT D    &mt LCTL F      &kp G           &kp H           &mt RCTL J      &mt RSHIFT K    &mt RALT L      &mt RGUI SEMI
&kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
                                &kp ESC         &lt 1 TAB       &kp SPACE       &kp RET         &lt 2 BSPC      &kp DEL
            >;
        };

        symbol_layer {
// -----------------------------------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
// |     |     |     |     |     |   | -_  | =+  | [{  | ]}  | \|  |
// |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  |  |
//             | ESC |    | SPC |   | ENT |    | DEL |
            bindings = <
&as LS(N1) N1   &as LS(N2) N2   &as LS(N3) N3   &as LS(N4) N4   &as LS(N5) N5       &as LS(N6) N6       &as LS(N7) N7       &as LS(N8) N8       &as LS(N9) N9       &as LS(N0) N0
&none           &none           &none           &none           &none               &as LS(MINUS) MINUS &as LS(EQUAL) EQUAL &as LS(LBKT) LBKT   &as LS(RBKT) RBKT   &as LS(BSLH) BSLH
&none           &none           &none           &none           &none               &kp UNDER           &kp PLUS            &kp LBRC            &kp RBRC            &kp PIPE  
                                &kp ESC         &lt 1 TAB       &kp SPACE           &kp RET             &lt 2 BSPC          &kp DEL
            >;
        };

        symbol_layer {
// -----------------------------------------------------------------------------------------
// | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
// | F11 | F12 |     |     |     |   |     | LT  | DW  | UP  |  RT |
// |BT CL|     | BT 0| BT 1| BT 2|   |     |HOME |PGDW |PGUP | END |
//             | ESC |    | SPC |   | ENT |    | DEL |
            bindings = <
&kp F1          &kp F2          &kp F3          &kp F4          &kp F5              &kp F6              &kp F7              &kp F8              &kp F9              &kp F10
&kp F11         &kp F12         &none           &none           &none               &none               &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT
&bt BT_CLR      &none           &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2        &none               &kp HOME            &kp PG_DN           &kp PG_UP           &kp END  
                                &kp ESC         &lt 1 TAB       &kp SPACE           &kp RET             &lt 2 BSPC          &kp DEL
            >;
        };
// &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };
};
