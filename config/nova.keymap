#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT     0
#define NUMBER      1
#define FUNCTION    2

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo_ret {
            bindings = <&kp RET>;
            key-positions = <23 24>;
            layers = <0>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_qwerty {
            // -----------------------------------------------------------------------------------------------------------
            //  |  Q   |  W   |  E   |  R   |  T   |      |  Y   |  U   |  I   |  O   |  P    |
            //  |  A   |  S   |  D   |  F   |  G   |      |  H   |  J   |  K   |  L   |  BSPC |
            //  |  Z   |  X   |  C   |  V   |  B   |      |  N   |  M   |  ,   |  .   |  /    |
            // |              |  LALT|  RET |  TAB |      | SPACE|  1   | LMETA|

            bindings = <
&as LS(Q) Q         &as LS(W) W         &as LS(E) E         &as LS(R) R         &as LS(T) T         &as LS(Y) Y         &as LS(U) U         &as LS(I) I         &as LS(O) O         &as LS(P) P
&as LS(A) A         &as LS(S) S         &as LS(D) D         &as LS(F) F         &as LS(G) G         &as LS(H) H         &as LS(J) J         &as LS(K) K         &as LS(L) L         &as LS(BSPC) BSPC
&as LS(Z) Z         &as LS(X) X         &as LS(C) C         &as LS(V) V         &as LS(B) B         &as LS(N) N         &as LS(M) M         &as LS(COMMA) COMMA &as LS(PERIOD) PERIOD &as LS(FSLH) FSLH
                                        &as LS(LALT) LALT   &lt 2 RET           &mt LCTRL TAB       &mt RSHFT SPACE     &mo 1               &as LS(LMETA) LMETA
            >;
        };

        num_sym {
            // -----------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // |  `  |     |     |  "  |  ?  |   |  _  |  +  |  {  |  }  |  |  |
            // |  ~  |     |     |  '  |  /  |   |  -  |  =  |  [  |  ]  |  \  |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&mt EXCL N1  &mt AT N2  &mt HASH N3  &mt DLLR N4  &mt PRCNT N5    &mt CARET N6  &mt AMPS N7  &mt ASTRK N8   &mt LPAR N9    &mt RPAR N0
&kp TILDE    &kp LEFT   &kp UP       &kp DOWN     &kp RIGHT       &kp MINUS     &kp EQUAL    &mt LBKT LBRC  &mt RBKT RBRC  &kp BSPC
&kp GRAVE    &kp HOME   &kp PG_UP    &kp PG_DN    &kp END         &kp DEL       &kp PERIOD   &kp SEMI       &kp SQT        &kp BSLH
                        &trans       &trans       &kp RET         &kp ESC       &trans       &trans
            >;
        };

        function {
            bindings = <
&kp F1     &kp F2    &kp F3        &kp F4    &kp F5       &kp F6    &kp F7     &kp F8     &mt F11 F9  &mt F12 F10
&kp TILDE  &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT   &none
&kp GRAVE  &kp AT    &none         &none     &none        &kp DEL   &kp COMMA  &kp COLON  &kp DQT     &kp PIPE
                     &trans        &trans    &kp RET      &kp ESC   &trans     &trans
            >;
        };

        Control {
            // -----------------------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
            // | F11 | F12 |     |     |     |   |     | LT  | DW  | UP  |  RT |
            // |BT CL|     | BT 0| BT 1| BT 2|   |     |HOME |PGDW |PGUP | END |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&kp ESC  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_CLR  &none   &none   &none  &bt BT_CLR_ALL
&none    &none  &none         &none         &none           &none       &none   &none   &none  &none
&none    &none  &none         &none         &none           &none       &none   &none   &none  &none
                &trans        &trans        &trans          &trans      &trans  &trans
            >;
        };

        // &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
