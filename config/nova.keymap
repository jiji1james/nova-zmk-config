#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT     0
#define NUMBER      1
#define FUNCTION    2

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo_ret {
            bindings = <&kp RET>;
            key-positions = <23 24>;
            layers = <0>;
        };

        combo-lbrc {
            bindings = <&kp LBRC>;
            key-positions = <12 13>;
            layers = <0>;
        };

        combo-rbrc {
            bindings = <&kp RBRC>;
            key-positions = <14 13>;
            layers = <0>;
        };

        combo_bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <12 13 14>;
            layers = <3>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_qwerty {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  | RET |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&kp Q        &as AT W     &kp E        &kp R       &kp T            &as MINUS Y      &as EQUAL U  &as LPAR I      &as RPAR O        &kp P
&kp A        &as LSHFT S  &as LMETA D  &as LALT F  &as LCTRL G      &kp H            &kp J        &kp K           &kp L             &kp BSPC
&mt LSHFT Z  &kp X        &kp C        &kp V       &kp B            &kp N            &kp M        &as SEMI COMMA  &as COLON PERIOD  &mt RSHFT FSLH
                          &kt LALT     &to 2       &mt LCTRL TAB    &mt RCTRL SPACE  &mo 1        &kp RET
            >;
        };

        num_sym {
            // -----------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // |  `  |     |     |  "  |  ?  |   |  _  |  +  |  {  |  }  |  |  |
            // |  ~  |     |     |  '  |  /  |   |  -  |  =  |  [  |  ]  |  \  |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&as EXCL N1      &as AT N2  &as HASH N3  &as DLLR N4  &as PRCNT N5     &as CARET N6  &as AMPS N7  &as ASTRK N8  &as LPAR N9     &as RPAR N0
&as TILDE GRAVE  &kp LEFT   &kp UP       &kp DOWN     &kp RIGHT        &kp MINUS     &kp EQUAL    &kp LBKT      &kp RBKT        &kp BSPC
&kp LSHFT        &kp HOME   &kp PG_UP    &kp PG_DN    &kp END          &kp DEL       &none        &as DQT SQT   &as COLON SEMI  &kp BSLH
                            &kp ESC      &to 0        &mt LCTRL TAB    &trans        &trans       &trans
            >;
        };

        mouse {
            bindings = <
&kp F1   &kp F2  &kp F3          &kp F4           &kp F5            &kp F6          &kp F7          &kp F8          &as F11 F9    &as F12 F10
&kp TAB  &none   &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_UP      &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&kp TAB  &none   &none           &none            &msc SCRL_DOWN    &msc SCRL_DOWN  &mkp MB1        &mkp MB4        &mkp MB5      &mkp MB2
                 &trans          &to 0            &trans            &trans          &trans          &trans
            >;
        };

        Control {
            // -----------------------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
            // | F11 | F12 |     |     |     |   |     | LT  | DW  | UP  |  RT |
            // |BT CL|     | BT 0| BT 1| BT 2|   |     |HOME |PGDW |PGUP | END |
            //             | ESC |  1  | SPC |   |BSPC |  2  | DEL |

            bindings = <
&none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_CLR  &none   &none   &none  &bt BT_CLR_ALL
&none  &none  &none         &none         &none           &none       &none   &none   &none  &none
&none  &none  &none         &none         &none           &none       &none   &none   &none  &none
              &trans        &to 0         &trans          &trans      &trans  &trans
            >;
        };

        // &none           &none           &none           &none           &none               &none           &none           &none           &none           &none 
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
